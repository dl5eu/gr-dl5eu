- name: bandwidth_decim_factor
  id: epy_module
  parameters:
    alias: ''
    comment: ''
    source_code: "# Central receiver-bandwidth configuration. Edit only these entries\
      \ when\n# changing the available bandwidths; update the matching GRC resampler\
      \ ports.\nPLUTO_SAMPLE_RATE = 2400000\nBANDWIDTHS = (\n#    (\"2 MHz\", 20,\
      \ 21),\n    (\"1 MHz\", 10, 21),\n#    (\"500 kHz\", 5, 21),\n#    (\"333 kHz\"\
      , 160, 1009),\n    (\"250 kHz\", 5, 42),\n    (\"125 kHz\", 5, 84),\n    (\"\
      66 kHz\", 280, 8909),\n)\n\n\ndef interpolation(index):\n    return BANDWIDTHS[int(index)][1]\n\
      \n\ndef decimation(index):\n    return BANDWIDTHS[int(index)][2]\n\n\ndef sample_rate(index):\n\
      \    return PLUTO_SAMPLE_RATE * interpolation(index) / decimation(index)\n\n\
      \ndef labels():\n    return [entry[0] for entry in BANDWIDTHS]\n\n\ndef indices():\n\
      \    return list(range(len(BANDWIDTHS)))"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 140.0]
    rotation: 0
    state: true
