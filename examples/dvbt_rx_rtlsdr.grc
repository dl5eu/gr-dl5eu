- name: snippet_0
  id: snippet
  parameters:
    alias: ''
    code: "import os\nimport sys\nfrom PyQt5 import QtCore\n\noriginal_set_restart\
      \ = self.set_restart\n\ndef restart_program():\n    self.stop()\n    self.wait()\n\
      \n    sys.stdout.flush()\n    sys.stderr.flush()\n\n    os.execv(\n        sys.executable,\n\
      \        [sys.executable, os.path.abspath(sys.argv[0]), *sys.argv[1:]]\n   \
      \ )\n\ndef set_restart(value):\n    original_set_restart(value)\n\n    if value:\n\
      \        QtCore.QTimer.singleShot(0, restart_program)\n\nself.set_restart =\
      \ set_restart"
    comment: ''
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 188.0]
    rotation: 0
    state: enabled
